# DriveLuxe — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database
# --------
# LOCAL: SQLite file — fully offline, no DB server. Created by `bun run db:push`.
DATABASE_URL=file:./dev.db

# PRODUCTION (Vercel / serverless): SQLite CANNOT be used — the serverless
# filesystem is ephemeral and the dev.db file is not deployed, so every query
# fails (login, register, bookings, etc.). You MUST use a hosted Postgres.
#
# The datasource provider in prisma/schema.prisma is switched automatically by
# scripts/sync-db-provider.js based on DATABASE_URL (run on install + build):
#   - file:...        -> provider "sqlite"   (local dev)
#   - postgres(ql):// -> provider "postgresql" (production)
# So you only need to set DATABASE_URL — no manual schema edits.
#
# Steps for production:
#   1. Create a free Postgres (Supabase, Neon, or Vercel Postgres).
#   2. In Vercel set DATABASE_URL to that connection string (and JWT_SECRET).
#   3. Push the schema + seed once:
#        DATABASE_URL=<your-postgres-url> bun run db:push
#        DATABASE_URL=<your-postgres-url> bunx prisma db seed
#      (Or apply the committed migration instead: bun run db:deploy)
#
# The old Supabase project is gone (its ref no longer resolves in DNS). Its
# original values are preserved in .env.supabase.bak if you want them back.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application Authentication
JWT_SECRET=

# Razorpay Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
